{
  "name": "ask-hr-m365-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src tests",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/identity": "4.13.3",
    "@azure/monitor-opentelemetry": "1.20.0",
    "@microsoft/agents-activity": "1.9.1",
    "@microsoft/agents-hosting": "1.9.1",
    "@microsoft/agents-hosting-express": "1.9.1",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@types/express": "5.0.3",
    "@types/node": "24.7.0",
    "eslint": "9.38.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  }
}
